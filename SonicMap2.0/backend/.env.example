# Copy this file to `.env` in the backend/ folder and fill in real values.
# Load it before starting the server, e.g.:
#   export $(grep -v '^#' .env | xargs)   # Linux/macOS
# or use `python-dotenv` / your process manager's env file support.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must EXACTLY match a Redirect URI registered in the Spotify Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Where the React dev server (or production frontend) is served from.
# The backend redirects back here after Spotify login.
FRONTEND_URL=http://127.0.0.1:5173

# Random secret used to sign SonicMap's own session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_long_random_value

# Database connection URL
# Local SQLite default: sqlite:///sonicmap.db (relative to backend/)
# Production Render PostgreSQL: postgresql://username:password@host:port/database
# DATABASE_URL=sqlite:///sonicmap.db
