# Optional. Copy to `.env.local` in frontend/ to override defaults.
# The frontend always calls the relative path /api/... and the Vite dev server
# proxies it to the FastAPI backend at this URL.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Only needed if you serve a production build without a reverse proxy for /api:
# VITE_API_BASE=http://127.0.0.1:8000/api
